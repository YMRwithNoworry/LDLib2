{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": [
    "KilaBash"
  ],
  "contact": {
    "homepage": "${mod_url}",
    "sources": "${mod_url}",
    "issues": "https://github.com/Low-Drag-MC/LDLib2/issues"
  },
  "license": "LGPL-3.0",
  "icon": "icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.lowdragmc.lowdraglib2.fabric.LDLib2Fabric"
    ],
    "client": [
      "com.lowdragmc.lowdraglib2.fabric.LDLib2FabricClient"
    ]
  },
  "mixins": [
    "ldlib2.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "minecraft": "~${minecraft_version}",
    "java": ">=21",
    "architectury": ">=${architectury_api_version}",
    "fabric-api": "*"
  }
}
